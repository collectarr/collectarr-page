---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="What's new in Collectarr Music: release notes, automated backups, regex search, and Discogs catalog updates."
    />
    <title>What's New in Collectarr Music — Updates & Release Notes</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body class="music-page">
    <a class="skip" href="#main">Skip to content</a>
    <Header currentKind="music" activeSubNav="whatsnew" />

    <main id="main">
      <section class="whatsnew-hero">
        <p class="eyebrow">COLLECTARR MUSIC UPDATES</p>
        <h1>What's new in Collectarr Music?</h1>
        <p class="intro">
          Explore recent features, format additions, and database improvements shipped in Collectarr Music.
        </p>
      </section>

      <div class="updates-container">
        <!-- Update 1: v1.2.0 Search & Regex -->
        <article class="update-card">
          <div class="update-meta">
            <span class="version-badge">Version 1.2.0</span>
            <span class="date">October 18, 2026</span>
          </div>
          <h2>Regular Expression Search (`matches:`)</h2>
          <p class="summary">
            Crate diggers and large library owners can now run complex pattern matching locally without sending queries to external servers.
          </p>
          <ul class="update-points">
            <li><strong>Regex Syntax:</strong> Type <code>matches: ^the\s</code> or any valid regular expression to filter tracks and album titles with immediate live highlighting.</li>
            <li><strong>Syntax Feedback:</strong> Invalid regular expressions cleanly outline the search bar in red with inline error explanations.</li>
            <li><strong>Fast & Local:</strong> Evaluated entirely on your local SQLite instance in milliseconds.</li>
          </ul>
        </article>

        <!-- Update 2: Automated Backups -->
        <article class="update-card">
          <div class="update-meta">
            <span class="version-badge">Data Safety</span>
            <span class="date">October 18, 2026</span>
          </div>
          <h2>Automated Daily Database Backups</h2>
          <p class="summary">
            Peace of mind for your precious music catalog with automated background backups.
          </p>
          <ul class="update-points">
            <li><strong>Daily Snapshot:</strong> The desktop and mobile apps create a full database snapshot once a day at startup and before every restore.</li>
            <li><strong>Custom Retention:</strong> Configure retention periods from one week up to forever in <strong>Settings → Data</strong>.</li>
            <li><strong>Safe Restore:</strong> Restoring an older snapshot automatically keeps a pre-restore backup first so actions can be cleanly reversed.</li>
          </ul>
        </article>

        <!-- Update 3: Sort Names -->
        <article class="update-card">
          <div class="update-meta">
            <span class="version-badge">Pick Lists</span>
            <span class="date">October 18, 2026</span>
          </div>
          <h2>Smart Sort Name Auto-Generation</h2>
          <p class="summary">
            Artist, label, and box set folders are now alphabetized correctly without manual bookkeeping.
          </p>
          <ul class="update-points">
            <li><strong>Automatic Articles:</strong> Typing <em>The End Records</em> automatically populates the Sort Name as <em>End Records, The</em>.</li>
            <li><strong>Folder Consistency:</strong> Every pick list folder is sorted strictly by Sort Name while displaying the natural artist or label name.</li>
            <li><strong>Custom Overrides:</strong> Edit individual Sort Names anytime in <strong>Manage Pick Lists</strong>.</li>
          </ul>
        </article>

        <!-- Update 4: Core & Discogs Lookups -->
        <article class="update-card">
          <div class="update-meta">
            <span class="version-badge">Cataloging</span>
            <span class="date">October 18, 2026</span>
          </div>
          <h2>Catalog Number Search & Update from Core Settings</h2>
          <p class="summary">
            Granular controls over how online metadata interacts with your curated library.
          </p>
          <ul class="update-points">
            <li><strong>Catalog No. Tab:</strong> Dedicated search tab in Add Albums for searching directly by matrix or label catalog numbers.</li>
            <li><strong>Update from Core Dialog:</strong> Choose per field whether updating from Core skips, fills missing values, or replaces existing data.</li>
            <li><strong>Personal Data Shield:</strong> Personal ratings, purchase prices, locations, and custom fields are always protected from overwrite.</li>
          </ul>
        </article>
      </div>

      <section class="updates-cta">
        <p class="eyebrow">DOWNLOAD THE LATEST VERSION</p>
        <h2>Keep your music library up to date</h2>
        <p>Available on Windows, macOS, Linux, Android, and iOS.</p>
        <div class="actions">
          <a class="primary" href="https://github.com/collectarr/collectarr-app/releases" target="_blank" rel="noopener">
            View Releases on GitHub ↗
          </a>
          <a class="secondary" href={`${base}music/`}>Back to Music Overview →</a>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  :global(*){box-sizing:border-box}
  :global(html){scroll-behavior:smooth}
  :global(body){margin:0;background:#151617;color:#f6f3ed;font-family:"Segoe UI",system-ui,sans-serif;line-height:1.6}
  :global(a){color:inherit;text-decoration:none}
  :global(a:focus-visible){outline:3px solid #f2932f;outline-offset:4px}
  :global(::selection){background:#f2932f;color:#151617}

  .skip {
    position: fixed;
    top: -100px;
    left: 20px;
    padding: 10px 16px;
    background: #f2932f;
    color: #151617;
    font-weight: 700;
    z-index: 1000;
  }
  .skip:focus { top: 15px; }

  main {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .whatsnew-hero {
    text-align: center;
    padding: 64px 16px 44px;
  }
  .eyebrow {
    font-size: 12px;
    letter-spacing: 0.14em;
    font-weight: 800;
    color: #f2932f;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .whatsnew-hero h1 {
    font-size: clamp(32px, 4vw, 54px);
    line-height: 1.15;
    letter-spacing: -0.04em;
    margin: 12px 0 16px;
  }
  .intro {
    font-size: 18px;
    color: #c4c7cc;
    max-width: 650px;
    margin: 0 auto;
  }

  .updates-container {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-bottom: 64px;
  }
  .update-card {
    background: #1a1c1f;
    border: 1px solid #282b30;
    border-radius: 10px;
    padding: 32px 28px;
    transition: border-color 0.2s ease;
  }
  .update-card:hover {
    border-color: #f2932f;
  }
  .update-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }
  .version-badge {
    font-size: 10.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 3px 8px;
    border-radius: 4px;
    background: rgba(242, 147, 47, 0.15);
    color: #fca74e;
  }
  .date {
    font-size: 12.5px;
    color: #8c9096;
  }
  .update-card h2 {
    font-size: 22px;
    margin: 0 0 10px;
    color: #f6f3ed;
  }
  .summary {
    color: #a8acb2;
    font-size: 15px;
    margin: 0 0 18px;
  }
  .update-points {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .update-points li {
    font-size: 14px;
    color: #c4c7cc;
    position: relative;
    padding-left: 20px;
  }
  .update-points li::before {
    content: '•';
    position: absolute;
    left: 4px;
    color: #f2932f;
    font-size: 18px;
    line-height: 1.2;
  }
  .update-points strong {
    color: #f6f3ed;
  }
  code {
    background: #24272c;
    padding: 2px 6px;
    border-radius: 4px;
    color: #f2932f;
    font-family: Consolas, monospace;
    font-size: 12.5px;
  }

  .updates-cta {
    background: #191b1e;
    border: 1px solid #2a2d33;
    border-radius: 12px;
    padding: 48px 32px;
    text-align: center;
    margin-bottom: 80px;
  }
  .updates-cta h2 {
    font-size: clamp(24px, 2.8vw, 36px);
    margin: 10px 0 12px;
  }
  .updates-cta p {
    color: #c4c7cc;
    margin: 0 auto 24px;
    max-width: 500px;
  }
  .actions {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .primary, .secondary {
    display: inline-flex;
    align-items: center;
    padding: 12px 22px;
    border-radius: 6px;
    font-weight: 750;
    font-size: 14px;
    transition: all 0.15s ease;
  }
  .primary {
    background: #f2932f;
    color: #151617;
  }
  .primary:hover {
    background: #ffac33;
    transform: translateY(-2px);
  }
  .secondary {
    border: 1px solid #4a4d52;
    background: #1e2023;
  }
  .secondary:hover {
    background: #2b2e33;
    transform: translateY(-2px);
  }
</style>
