---
import ThemeHead from '../../../components/ThemeHead.astro';
import Header from '../../../components/Header.astro';
import ReleaseTimeline from '../../../components/ReleaseTimeline.astro';
import Footer from '../../../components/Footer.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="What's new in Collectarr Music: release notes for every stable version, from v1.0.0 to the latest."
    />
    <title>What's New in Collectarr Music — Updates & Release Notes</title>
    <ThemeHead />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body class="music-page">
    <a class="skip" href="#main">Skip to content</a>
    <Header currentKind="music" activeSubNav="whatsnew" />

    <main id="main">
      <section class="whatsnew-hero">
        <p class="eyebrow">COLLECTARR MUSIC UPDATES</p>
        <h1>What's new in Collectarr Music?</h1>
        <p class="intro">
          Release notes for every stable version of Collectarr Music, newest first.
        </p>
      </section>

      <ReleaseTimeline kindFilter="music" />

      <section class="updates-cta">
        <p class="eyebrow">DOWNLOAD THE LATEST VERSION</p>
        <h2>Keep your music library up to date</h2>
        <p>Available for Windows, macOS, Linux and Android, with a web bundle and Docker image.</p>
        <div class="actions">
          <a class="primary" href="https://github.com/collectarr/collectarr-app/releases" target="_blank" rel="noopener">
            View Releases on GitHub ↗
          </a>
          <a class="secondary" href={`${base}music/`}>Back to Music Overview →</a>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  :global(*){box-sizing:border-box}
  :global(html){scroll-behavior:smooth}
  :global(body){margin:0;background:var(--bg);color:var(--text);font-family:"Segoe UI",system-ui,sans-serif;line-height:1.6}
  :global(a){color:inherit;text-decoration:none}
  :global(a:focus-visible){outline:3px solid #f2932f;outline-offset:4px}
  :global(::selection){background:#f2932f;color:var(--on-accent)}

  .skip {
    position: fixed;
    top: -100px;
    left: 20px;
    padding: 10px 16px;
    background: #f2932f;
    color: var(--on-accent);
    font-weight: 700;
    z-index: 1000;
  }
  .skip:focus { top: 15px; }

  main {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .whatsnew-hero {
    text-align: center;
    padding: 64px 16px 44px;
  }
  .eyebrow {
    font-size: 12px;
    letter-spacing: 0.14em;
    font-weight: 800;
    color: var(--music-text);
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .whatsnew-hero h1 {
    font-size: clamp(32px, 4vw, 54px);
    line-height: 1.15;
    letter-spacing: -0.04em;
    margin: 12px 0 16px;
  }
  .intro {
    font-size: 18px;
    color: var(--text-2);
    max-width: 650px;
    margin: 0 auto;
  }

  .updates-cta {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 48px 32px;
    text-align: center;
    margin-bottom: 80px;
  }
  .updates-cta h2 {
    font-size: clamp(24px, 2.8vw, 36px);
    margin: 10px 0 12px;
  }
  .updates-cta p {
    color: var(--text-2);
    margin: 0 auto 24px;
    max-width: 500px;
  }
  .actions {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .primary, .secondary {
    display: inline-flex;
    align-items: center;
    padding: 12px 22px;
    border-radius: 6px;
    font-weight: 750;
    font-size: 14px;
    transition: all 0.15s ease;
  }
  .primary {
    background: #f2932f;
    color: var(--on-accent);
  }
  .primary:hover {
    background: #ffac33;
    transform: translateY(-2px);
  }
  .secondary {
    border: 1px solid var(--line-2);
    background: var(--surface);
  }
  .secondary:hover {
    background: var(--surface-2);
    transform: translateY(-2px);
  }
</style>
