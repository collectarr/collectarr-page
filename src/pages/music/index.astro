---
import { Image } from 'astro:assets';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import workspace from '../../assets/screenshots/library.png';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Collectarr Music is a local-first collection database for vinyl records, CDs, and audio media. Track multi-disc sets, matrices, track lists, and contributor credits."
    />
    <title>Collectarr Music — Vinyl & CD Music Collection Manager</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body class="music-page">
    <a class="skip" href="#main">Skip to content</a>
    <Header currentKind="music" activeSubNav="overview" />

    <main id="main">
      <section class="hero">
        <p class="eyebrow">FOR AUDIOPHILES, VINYL ENTHUSIASTS & CRATE DIGGERS</p>
        <h1>Music albums, discs & tracks.<br /><span>The depth physical media deserves.</span></h1>
        <p class="intro">
          Collectarr Music models the physical realities of records, optical media, and digital files.
          Catalog multi-disc containers, dead-wax runouts, track playing times, and contributor credits.
        </p>
        <div class="actions">
          <a class="primary" href="https://github.com/collectarr/collectarr-app/releases" target="_blank" rel="noopener">Explore Music releases ↗</a>
          <a class="secondary" href={`${base}manual/kinds/music/`}>Read Music user manual →</a>
          <a class="forum-btn" href="https://github.com/collectarr/collectarr-app/discussions?discussions_q=music" target="_blank" rel="noopener">Music Support Forum ↗</a>
        </div>
        <p class="note">Local-first · Offline database · Vinyl, Optical & Hi-Res Digital</p>

        <figure class="workspace-preview">
          <Image src={workspace} alt="Collectarr Music workspace showing album collection folders and details inspector" loading="eager" />
          <figcaption>The Music workspace. Your library stays private and local on your machine.</figcaption>
        </figure>
      </section>

      <section class="features" aria-label="Collectarr Music features">
        <article class="feature-card">
          <span class="number">01</span>
          <h2>Multi-Disc Containers</h2>
          <p>
            An album is not just a flat list of files; it contains physical discs (or tape/vinyl sides).
            Easily catalog box sets mixing vinyl LPs and bonus CDs with accurate format summaries.
          </p>
          <a href={`${base}manual/kinds/music/#1-album-and-disc-architecture`}>Album architecture →</a>
        </article>

        <article class="feature-card">
          <span class="number">02</span>
          <h2>Format Families & Runouts</h2>
          <p>
            Track vinyl dead-wax matrices, pressing plants, lacquer cuts, weight (180g), and RPM.
            Supports CD, SACD, DVD-Audio, Cassette, Reel-to-Reel, and lossless FLAC.
          </p>
          <a href={`${base}manual/kinds/music/#2-discs-formats-and-technical-metadata`}>Formats guide →</a>
        </article>

        <article class="feature-card">
          <span class="number">03</span>
          <h2>Track Lists & Playing Times</h2>
          <p>
            Sequential track indexing per disc (or side positions A1, A2, B1...).
            Automatic duration aggregation gives exact disc playing times and total album running lengths.
          </p>
          <a href={`${base}manual/kinds/music/#3-track-lists-and-durations`}>Track workflows →</a>
        </article>

        <article class="feature-card">
          <span class="number">04</span>
          <h2>Contributor Credits & Scope</h2>
          <p>
            Credit musicians, composers, conductors, producers, engineers, and songwriters at the album,
            disc, or track level. Filter your library by anyone involved in the recording.
          </p>
          <a href={`${base}manual/kinds/music/#4-contributor-credits-and-scope`}>Credits system →</a>
        </article>

        <article class="feature-card">
          <span class="number">05</span>
          <h2>Catalog & Barcode Lookups</h2>
          <p>
            Scan barcodes with your webcam or phone camera, search Discogs catalog numbers,
            or query online Core catalog metadata for instant cover art and track lists.
          </p>
          <a href={`${base}manual/adding/`}>Adding entries →</a>
        </article>

        <article class="feature-card">
          <span class="number">06</span>
          <h2>Shelves, Covers & Flow</h2>
          <p>
            Browse your collection the way you want: dense table list, album covers grid, virtual shelves,
            or Flow Carousel. Filter by vinyl color, label, release year, or custom pick lists.
          </p>
          <a href={`${base}manual/browsing/`}>Browsing views →</a>
        </article>
      </section>

      <section id="formats" class="deep-dive">
        <div class="deep-dive-header">
          <p class="eyebrow">PHYSICAL & TECHNICAL PRECISION</p>
          <h2>Discs, Formats & Technical Metadata</h2>
          <p>
            Whether it's an original 1973 first-press vinyl or a modern 24-bit Hi-Res master,
            Collectarr Music records the technical details that matter.
          </p>
        </div>

        <div class="grid-two">
          <div class="info-box">
            <div class="info-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9" />
                <circle cx="12" cy="12" r="3" />
                <path d="M12 3v3m0 12v3M3 12h3m12 0h3" />
              </svg>
            </div>
            <h3>Vinyl Specs</h3>
            <ul>
              <li><strong>Dead-wax runout matrices:</strong> Record matrix etchings, pressing plant symbols, and mastering signatures.</li>
              <li><strong>Vinyl weights:</strong> Standard 120g, 140g, 180g audiophile, and 200g pressings.</li>
              <li><strong>Speeds & sizes:</strong> 33⅓ RPM 12" LP, 45 RPM 7" Single, 10" EP, and flexi-discs.</li>
              <li><strong>Packaging:</strong> Gatefold, trifold, box set, die-cut sleeve, OBI strip, or inner sleeves.</li>
            </ul>
          </div>

          <div class="info-box">
            <div class="info-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2" />
                <path d="M6 8h12M6 12h8M6 16h5" />
              </svg>
            </div>
            <h3>Optical & Digital Media</h3>
            <ul>
              <li><strong>SPARS codes:</strong> Recording, mixing, and mastering source codes (DDD, ADD, AAD).</li>
              <li><strong>Optical standards:</strong> CD, Hybrid SACD, DVD-Audio, and Blu-ray Audio with high bitrates.</li>
              <li><strong>Disc types:</strong> Flag discs as Studio, Live, or Compilation within the same box set.</li>
              <li><strong>Recording sessions:</strong> Document when and where specific studio or live dates occurred.</li>
            </ul>
          </div>
        </div>
      </section>

      <section id="tracks-credits" class="callout-section">
        <div class="callout-inner">
          <p class="eyebrow">COMMUNITY & SUPPORT</p>
          <h2>Join the Collectarr Music discussions</h2>
          <p>
            Share feedback on Discogs imports, audiophile metadata, and upcoming music features
            with the community on GitHub Discussions.
          </p>
          <div class="actions">
            <a class="primary" href="https://github.com/collectarr/collectarr-app/discussions?discussions_q=music" target="_blank" rel="noopener">
              Open Music Support Forum ↗
            </a>
            <a class="secondary" href={`${base}contact/?kind=music`}>
              Contact & Diagnostics Hub →
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  :global(*){box-sizing:border-box}
  :global(html){scroll-behavior:smooth}
  :global(body){margin:0;background:#151617;color:#f6f3ed;font-family:"Segoe UI",system-ui,sans-serif;line-height:1.6}
  :global(a){color:inherit;text-decoration:none}
  :global(a:focus-visible){outline:3px solid #f2932f;outline-offset:4px}
  :global(::selection){background:#f2932f;color:#17191a}

  .skip {
    position: fixed;
    top: -100px;
    left: 20px;
    padding: 10px 16px;
    background: #f2932f;
    color: #17191a;
    font-weight: 700;
    z-index: 1000;
  }
  .skip:focus { top: 15px; }

  main {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Hero */
  .hero {
    text-align: center;
    padding: 68px 16px 48px;
    max-width: 1000px;
    margin: 0 auto;
  }
  .eyebrow {
    font-size: 12px;
    letter-spacing: 0.14em;
    font-weight: 800;
    color: #f2932f;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .hero h1 {
    font-size: clamp(34px, 4.8vw, 64px);
    line-height: 1.12;
    letter-spacing: -0.04em;
    margin: 16px 0 24px;
  }
  .hero h1 span {
    color: #f2932f;
  }
  .intro {
    font-size: 18.5px;
    line-height: 1.55;
    color: #c4c7cc;
    max-width: 720px;
    margin: 0 auto 32px;
  }
  .actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  .primary, .secondary, .forum-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    padding: 12px 22px;
    font-weight: 750;
    font-size: 14px;
    transition: transform 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
  }
  .primary {
    background: #f2932f;
    color: #151617;
  }
  .primary:hover {
    background: #ffac33;
    transform: translateY(-2px);
  }
  .secondary {
    border: 1px solid #4a4d52;
    background: #1e2023;
    color: #f6f3ed;
  }
  .secondary:hover {
    background: #2b2e33;
    border-color: #727780;
    transform: translateY(-2px);
  }
  .forum-btn {
    border: 1px solid rgba(242, 147, 47, 0.4);
    background: rgba(242, 147, 47, 0.08);
    color: #fca74e;
  }
  .forum-btn:hover {
    background: rgba(242, 147, 47, 0.18);
    transform: translateY(-2px);
  }
  .note {
    color: #8c9096;
    font-size: 12.5px;
    letter-spacing: 0.04em;
    margin-bottom: 36px;
  }
  .workspace-preview {
    margin: 0;
  }
  .workspace-preview img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid #4d3a2b;
    border-radius: 10px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
  }
  .workspace-preview figcaption {
    font-size: 12.5px;
    color: #8c9096;
    margin-top: 14px;
  }

  /* Features Grid */
  .features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    padding: 40px 0 64px;
  }
  .feature-card {
    background: #1a1c1f;
    border: 1px solid #282b30;
    border-radius: 8px;
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .feature-card:hover {
    border-color: #f2932f;
    transform: translateY(-3px);
  }
  .number {
    font-size: 13px;
    font-weight: 800;
    color: #f2932f;
    letter-spacing: 0.08em;
    margin-bottom: 12px;
  }
  .feature-card h2 {
    font-size: 20px;
    line-height: 1.3;
    margin: 0 0 12px;
    color: #f6f3ed;
  }
  .feature-card p {
    color: #a8acb2;
    font-size: 14.5px;
    line-height: 1.55;
    flex-grow: 1;
    margin: 0 0 20px;
  }
  .feature-card a {
    color: #f2932f;
    font-weight: 700;
    font-size: 13.5px;
  }
  .feature-card a:hover {
    text-decoration: underline;
  }

  /* Deep Dive Section */
  .deep-dive {
    padding: 64px 0;
    border-top: 1px solid #25282c;
  }
  .deep-dive-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 48px;
  }
  .deep-dive-header h2 {
    font-size: clamp(28px, 3.5vw, 42px);
    line-height: 1.2;
    letter-spacing: -0.03em;
    margin: 12px 0 16px;
  }
  .deep-dive-header p {
    color: #a8acb2;
    font-size: 16px;
  }
  .grid-two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  .info-box {
    background: #1a1c1f;
    border: 1px solid #282b30;
    border-radius: 8px;
    padding: 32px 28px;
  }
  .info-icon {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    background: rgba(242, 147, 47, 0.12);
    color: #f2932f;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }
  .info-icon svg {
    width: 26px;
    height: 26px;
  }
  .info-box h3 {
    font-size: 20px;
    margin: 0 0 16px;
    color: #f6f3ed;
  }
  .info-box ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .info-box li {
    font-size: 14px;
    color: #a8acb2;
    line-height: 1.55;
    position: relative;
    padding-left: 20px;
  }
  .info-box li::before {
    content: '•';
    position: absolute;
    left: 4px;
    color: #f2932f;
    font-size: 18px;
    line-height: 1.2;
  }
  .info-box strong {
    color: #f6f3ed;
  }

  /* Callout section */
  .callout-section {
    padding: 48px 0 80px;
  }
  .callout-inner {
    background: linear-gradient(180deg, #221d17 0%, #171615 100%);
    border: 1px solid rgba(242, 147, 47, 0.25);
    border-radius: 12px;
    padding: 56px 32px;
    text-align: center;
    max-width: 840px;
    margin: 0 auto;
  }
  .callout-inner h2 {
    font-size: clamp(26px, 3vw, 38px);
    margin: 12px 0 16px;
    letter-spacing: -0.03em;
  }
  .callout-inner p {
    color: #c4c7cc;
    max-width: 600px;
    margin: 0 auto 30px;
    font-size: 16px;
  }

  @media (max-width: 900px) {
    .features {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
    .grid-two {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding: 44px 12px 32px;
    }
    .intro {
      font-size: 16px;
    }
    .features {
      grid-template-columns: 1fr;
    }
    .actions {
      flex-direction: column;
      width: 100%;
    }
    .actions > a {
      width: 100%;
    }
    .callout-inner {
      padding: 40px 20px;
    }
  }
</style>
