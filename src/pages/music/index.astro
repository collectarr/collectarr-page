---
import { Image } from 'astro:assets';
import ThemeHead from '../../components/ThemeHead.astro';
import Header from '../../components/Header.astro';
import Faq from '../../components/Faq.astro';
import Footer from '../../components/Footer.astro';
import workspace from '../../assets/screenshots/library.png';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const faqItems = [
  {
    "q": "Is Collectarr Music really free?",
    "a": "Yes. Collectarr is free and open-source software. There is no subscription and no account required to keep a library."
  },
  {
    "q": "Where is my music collection stored?",
    "a": "In a local SQLite database on your own device. Nothing is uploaded unless you configure optional personal sync."
  },
  {
    "q": "Can I move over a collection from CLZ Music?",
    "a": "Yes. Collectarr Music imports native CSV and CLZ Music XML files, keeping track lists and custom fields. See the import guide in the manual."
  },
  {
    "q": "Can I catalog box sets with both vinyl and CDs?",
    "a": "Yes. An album is a container of physical discs, each with its own format, so a box set can mix LPs and bonus CDs."
  },
  {
    "q": "Does it work without an internet connection?",
    "a": "Yes. Browsing, editing and searching your library are fully offline. Only catalog lookups such as Discogs and Core need a connection."
  },
  {
    "q": "Which platforms are supported?",
    "a": "Windows, macOS, Linux and Android, plus a web bundle and Docker image for self-hosting."
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Collectarr Music is a local-first collection database for vinyl records, CDs, and audio media. Track multi-disc sets, matrices, track lists, and contributor credits."
    />
    <title>Collectarr Music — Vinyl & CD Music Collection Manager</title>
    <ThemeHead />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body class="music-page">
    <a class="skip" href="#main">Skip to content</a>
    <Header currentKind="music" activeSubNav="overview" />

    <main id="main">
      <!-- Hero Section -->
      <section class="hero">
        <p class="eyebrow">MUSIC DATABASE SOFTWARE</p>
        <h1>Catalog your<br /><span>CDs and vinyl records.</span></h1>
        <p class="intro">
          Keep track of your physical albums, discs, and tracks across vinyl, optical, and lossless audio.
          Use the mobile app while crate digging, the native desktop client at your desk, or self-host in your browser.
        </p>
        <div class="actions">
          <a class="primary" href="https://github.com/collectarr/collectarr-app/releases" target="_blank" rel="noopener">Explore Music releases ↗</a>
          <a class="secondary" href={`${base}manual/kinds/music/`}>Read Music user manual →</a>
          <a class="forum-btn" href="https://github.com/collectarr/collectarr-app/discussions?discussions_q=music" target="_blank" rel="noopener">Music Support Forum ↗</a>
        </div>
        <div class="availability-badges">
          <span class="badge">iOS & Android</span>
          <span class="badge">Windows, macOS & Linux</span>
          <span class="badge">Web & Docker</span>
          <span class="badge highlight">100% Free & Open-Source</span>
        </div>

        <figure class="workspace-preview">
          <Image src={workspace} alt="Collectarr Music workspace showing album collection folders and details inspector" loading="eager" />
          <figcaption>The Music workspace. Your library stays private and local on your machine.</figcaption>
        </figure>
      </section>

      <!-- 3 Cataloging Methods (How to Add) -->
      <section id="how-to-add" class="cataloging-methods">
        <div class="section-heading">
          <p class="eyebrow">EFFORTLESS CATALOGING</p>
          <h2>Three simple ways to catalog your music</h2>
          <p>Whether you're cataloging ten records or a massive wall-to-wall vinyl archive.</p>
        </div>

        <div class="methods-grid">
          <div class="method-card">
            <div class="method-num">01</div>
            <div class="method-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2" />
                <path d="M6 8v8m4-8v8m2-8v8m4-8v8m2-8v8" />
              </svg>
            </div>
            <h3>Scan Barcodes</h3>
            <p>
              Scan vinyl jacket or CD jewel case barcodes with your phone's camera, desktop webcam, or a USB scanner.
              Instant matches download album artwork, complete track lists, label, and release year.
            </p>
            <span class="method-tag">Fastest for modern vinyl & CDs</span>
          </div>

          <div class="method-card">
            <div class="method-num">02</div>
            <div class="method-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="7" />
                <path d="m21 21-4.35-4.35" />
              </svg>
            </div>
            <h3>Search Discogs & Core by Title</h3>
            <p>
              Type the artist and album title or label catalog number (e.g. <em>Blue Note BST 81595</em>).
              Inspect track positions, pressing countries, and edition packaging before adding to your collection.
            </p>
            <span class="method-tag">Ideal for vintage pressings</span>
          </div>

          <div class="method-card">
            <div class="method-num">03</div>
            <div class="method-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 5v14M5 12h14" />
                <circle cx="12" cy="12" r="9" />
              </svg>
            </div>
            <h3>Add Custom & Live Recordings</h3>
            <p>
              Catalog unreleased live soundboard bootlegs, local band flexi-discs, demo tapes, and test pressings.
              Add custom vinyl colors, dead-wax runout matrices, and personal high-resolution photos.
            </p>
            <span class="method-tag">Audiophile flexibility</span>
          </div>
        </div>

        <div class="import-banner">
          <p>
            <strong>Switching from CLZ Music or Discogs?</strong>
            Collectarr provides lossless native CSV and CLZ Music XML imports with track list and custom field preservation.
          </p>
          <a class="import-link" href={`${base}manual/import-export/`}>Learn about importing →</a>
        </div>
      </section>

      <!-- Features Grid -->
      <section class="features" aria-label="Collectarr Music features">
        <article class="feature-card">
          <span class="number">01</span>
          <h2>Multi-Disc Containers</h2>
          <p>
            An album is not just a flat list of files; it contains physical discs (or tape/vinyl sides).
            Easily catalog box sets mixing vinyl LPs and bonus CDs with accurate format summaries.
          </p>
          <a href={`${base}manual/kinds/music/#1-album-and-disc-architecture`}>Album architecture →</a>
        </article>

        <article class="feature-card">
          <span class="number">02</span>
          <h2>Format Families & Runouts</h2>
          <p>
            Track vinyl dead-wax matrices, pressing plants, lacquer cuts, weight (180g), and RPM.
            Supports CD, SACD, DVD-Audio, Cassette, Reel-to-Reel, and lossless FLAC.
          </p>
          <a href={`${base}manual/kinds/music/#2-discs-formats-and-technical-metadata`}>Formats guide →</a>
        </article>

        <article class="feature-card">
          <span class="number">03</span>
          <h2>Track Lists & Playing Times</h2>
          <p>
            Sequential track indexing per disc (or side positions A1, A2, B1...).
            Automatic duration aggregation gives exact disc playing times and total album running lengths.
          </p>
          <a href={`${base}manual/kinds/music/#3-track-lists-and-durations`}>Track workflows →</a>
        </article>

        <article class="feature-card">
          <span class="number">04</span>
          <h2>Contributor Credits & Scope</h2>
          <p>
            Credit musicians, composers, conductors, producers, engineers, and songwriters at the album,
            disc, or track level. Filter your library by anyone involved in the recording.
          </p>
          <a href={`${base}manual/kinds/music/#4-contributor-credits-and-scope`}>Credits system →</a>
        </article>

        <article class="feature-card">
          <span class="number">05</span>
          <h2>Catalog & Barcode Lookups</h2>
          <p>
            Scan barcodes with your webcam or phone camera, search Discogs catalog numbers,
            or query online Core catalog metadata for instant cover art and track lists.
          </p>
          <a href={`${base}manual/adding/`}>Adding entries →</a>
        </article>

        <article class="feature-card">
          <span class="number">06</span>
          <h2>Shelves, Covers & Flow</h2>
          <p>
            Browse your collection the way you want: dense table list, album covers grid, virtual shelves,
            or Flow Carousel. Filter by vinyl color, label, release year, or custom pick lists.
          </p>
          <a href={`${base}manual/browsing/`}>Browsing views →</a>
        </article>
      </section>

      <!-- Companions Section -->
      <section class="companions-section">
        <div class="companions-inner">
          <p class="eyebrow">AVAILABLE EVERYWHERE</p>
          <h2>Mobile, Web & Desktop — perfect companions!</h2>
          <p class="companions-intro">
            Use the mobile app on your phone while crate digging at the record store, and use the desktop or web version
            on your computer for deep editing and collection management.
          </p>

          <div class="companions-grid">
            <div class="companion-box">
              <div class="companion-tag">While crate digging</div>
              <h3>Collectarr Mobile</h3>
              <p>
                Browse your collection on your phone while flicking through vinyl bins. Check your exact pressing details
                to avoid buying duplicates, or check your wish list for missing albums.
              </p>
              <ul>
                <li>Quick barcode scanning with mobile camera</li>
                <li>Offline library stays accessible in basement record shops</li>
                <li>Instant wish list check with one tap</li>
              </ul>
            </div>

            <div class="companion-box">
              <div class="companion-tag">Back at your listening room</div>
              <h3>Collectarr Desktop & Web</h3>
              <p>
                Relax at your desk with high-density table views, full keyboard navigation, automated daily backups,
                matrix runout entry, and extensive statistics across all your shelves.
              </p>
              <ul>
                <li>Fast multi-column sorting and filtering</li>
                <li>Regex search (<code>matches: ^the\s</code>) across large collections</li>
                <li>Automatic daily backups with rollback protections</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- Deep Dive Formats -->
      <section id="formats" class="deep-dive">
        <div class="deep-dive-header">
          <p class="eyebrow">PHYSICAL & TECHNICAL PRECISION</p>
          <h2>Discs, Formats & Technical Metadata</h2>
          <p>
            Whether it's an original 1973 first-press vinyl or a modern 24-bit Hi-Res master,
            Collectarr Music records the technical details that matter.
          </p>
        </div>

        <div class="grid-two">
          <div class="info-box">
            <div class="info-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9" />
                <circle cx="12" cy="12" r="3" />
                <path d="M12 3v3m0 12v3M3 12h3m12 0h3" />
              </svg>
            </div>
            <h3>Vinyl Specs</h3>
            <ul>
              <li><strong>Dead-wax runout matrices:</strong> Record matrix etchings, pressing plant symbols, and mastering signatures.</li>
              <li><strong>Vinyl weights:</strong> Standard 120g, 140g, 180g audiophile, and 200g pressings.</li>
              <li><strong>Speeds & sizes:</strong> 33⅓ RPM 12" LP, 45 RPM 7" Single, 10" EP, and flexi-discs.</li>
              <li><strong>Packaging:</strong> Gatefold, trifold, box set, die-cut sleeve, OBI strip, or inner sleeves.</li>
            </ul>
          </div>

          <div class="info-box">
            <div class="info-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2" />
                <path d="M6 8h12M6 12h8M6 16h5" />
              </svg>
            </div>
            <h3>Optical & Digital Media</h3>
            <ul>
              <li><strong>SPARS codes:</strong> Recording, mixing, and mastering source codes (DDD, ADD, AAD).</li>
              <li><strong>Optical standards:</strong> CD, Hybrid SACD, DVD-Audio, and Blu-ray Audio with high bitrates.</li>
              <li><strong>Disc types:</strong> Flag discs as Studio, Live, or Compilation within the same box set.</li>
              <li><strong>Recording sessions:</strong> Document when and where specific studio or live dates occurred.</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Why Choose Collectarr (Comparison table) -->
      <section class="comparison-section">
        <div class="section-heading">
          <p class="eyebrow">WHY AUDIOPHILES CHOOSE COLLECTARR</p>
          <h2>Local-first freedom vs. proprietary cloud lock-in</h2>
          <p>Compare Collectarr with commercial cloud database subscriptions.</p>
        </div>

        <div class="table-wrapper">
          <table class="comparison-table">
            <thead>
              <tr>
                <th>Capability</th>
                <th>Commercial Cloud Software (CLZ)</th>
                <th>Collectarr Music</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Pricing</strong></td>
                <td>Mandatory subscription (€49.90 / year)</td>
                <td><span class="highlight-text">100% Free & Open-Source</span></td>
              </tr>
              <tr>
                <td><strong>Data Ownership</strong></td>
                <td>Trapped on vendor's cloud server</td>
                <td><span class="highlight-text">Local SQLite database on your device</span></td>
              </tr>
              <tr>
                <td><strong>Multi-Disc Modeling</strong></td>
                <td>Flat format pick list</td>
                <td><span class="highlight-text">Physical multi-disc containers</span></td>
              </tr>
              <tr>
                <td><strong>Runout / Matrix Specs</strong></td>
                <td>Single generic text field</td>
                <td><span class="highlight-text">Dedicated disc-level matrix & dead-wax fields</span></td>
              </tr>
              <tr>
                <td><strong>Track Durations</strong></td>
                <td>Basic manual entry</td>
                <td><span class="highlight-text">Automatic disc and album duration aggregation</span></td>
              </tr>
              <tr>
                <td><strong>Privacy</strong></td>
                <td>Account tracking & analytics</td>
                <td><span class="highlight-text">Zero telemetry, completely offline capable</span></td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Community Reviews -->
      <Faq title="Questions about Collectarr Music" items={faqItems} />

      <!-- Callout / Support CTA -->
      <section id="tracks-credits" class="callout-section">
        <div class="callout-inner">
          <p class="eyebrow">COMMUNITY & SUPPORT</p>
          <h2>Join the Collectarr Music discussions</h2>
          <p>
            Share feedback on Discogs imports, audiophile metadata, and upcoming music features
            with the community on GitHub Discussions.
          </p>
          <div class="actions">
            <a class="primary" href="https://github.com/collectarr/collectarr-app/discussions?discussions_q=music" target="_blank" rel="noopener">
              Open Music Support Forum ↗
            </a>
            <a class="secondary" href={`${base}contact/?kind=music`}>
              Contact & Diagnostics Hub →
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  :global(*){box-sizing:border-box}
  :global(html){scroll-behavior:smooth}
  :global(body){margin:0;background:var(--bg);color:var(--text);font-family:"Segoe UI",system-ui,sans-serif;line-height:1.6}
  :global(a){color:inherit;text-decoration:none}
  :global(a:focus-visible){outline:3px solid #f2932f;outline-offset:4px}
  :global(::selection){background:#f2932f;color:var(--surface)}

  .skip {
    position: fixed;
    top: -100px;
    left: 20px;
    padding: 10px 16px;
    background: #f2932f;
    color: var(--surface);
    font-weight: 700;
    z-index: 1000;
  }
  .skip:focus { top: 15px; }

  main {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Hero */
  .hero {
    text-align: center;
    padding: 68px 16px 48px;
    max-width: 1000px;
    margin: 0 auto;
  }
  .eyebrow {
    font-size: 12px;
    letter-spacing: 0.14em;
    font-weight: 800;
    color: var(--music-text);
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .hero h1 {
    font-size: clamp(36px, 5vw, 68px);
    line-height: 1.1;
    letter-spacing: -0.04em;
    margin: 14px 0 20px;
  }
  .hero h1 span {
    color: var(--music-text);
  }
  .intro {
    font-size: 18.5px;
    line-height: 1.55;
    color: var(--text-2);
    max-width: 740px;
    margin: 0 auto 30px;
  }
  .actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  .primary, .secondary, .forum-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    padding: 12px 22px;
    font-weight: 750;
    font-size: 14px;
    transition: transform 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
  }
  .primary {
    background: #f2932f;
    color: var(--on-accent);
  }
  .primary:hover {
    background: #ffac33;
    transform: translateY(-2px);
  }
  .secondary {
    border: 1px solid var(--line-2);
    background: var(--surface);
    color: var(--text);
  }
  .secondary:hover {
    background: var(--surface-2);
    border-color: var(--line-2);
    transform: translateY(-2px);
  }
  .forum-btn {
    border: 1px solid rgba(242, 147, 47, 0.4);
    background: rgba(242, 147, 47, 0.08);
    color: #fca74e;
  }
  .forum-btn:hover {
    background: rgba(242, 147, 47, 0.18);
    transform: translateY(-2px);
  }

  .availability-badges {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 10px;
  }
  .availability-badges .badge {
    font-size: 11px;
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 4px 10px;
    border-radius: 4px;
    background: var(--surface);
    color: var(--text-4);
    border: 1px solid var(--line);
  }
  .availability-badges .badge.highlight {
    background: rgba(242, 147, 47, 0.15);
    color: #ffb15c;
    border-color: rgba(242, 147, 47, 0.3);
  }

  .workspace-preview {
    margin: 36px 0 0;
  }
  .workspace-preview img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line-2);
    border-radius: 10px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
  }
  .workspace-preview figcaption {
    font-size: 12.5px;
    color: var(--text-4);
    margin-top: 14px;
  }

  /* Cataloging Methods */
  .cataloging-methods {
    padding: 64px 0 48px;
    border-top: 1px solid var(--line);
  }
  .section-heading {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 44px;
  }
  .section-heading h2 {
    font-size: clamp(28px, 3.5vw, 42px);
    line-height: 1.2;
    letter-spacing: -0.03em;
    margin: 10px 0 14px;
  }
  .section-heading p {
    color: var(--text-3);
    font-size: 16px;
  }
  .methods-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .method-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: all 0.2s ease;
  }
  .method-card:hover {
    border-color: #f2932f;
    transform: translateY(-2px);
  }
  .method-num {
    font-size: 13px;
    font-weight: 800;
    color: var(--music-text);
    letter-spacing: 0.08em;
    margin-bottom: 12px;
  }
  .method-icon {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    background: rgba(242, 147, 47, 0.12);
    color: var(--music-text);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
  }
  .method-icon svg {
    width: 24px;
    height: 24px;
  }
  .method-card h3 {
    font-size: 19px;
    margin: 0 0 10px;
    color: var(--text);
  }
  .method-card p {
    color: var(--text-3);
    font-size: 14px;
    line-height: 1.55;
    margin: 0 0 18px;
    flex-grow: 1;
  }
  .method-tag {
    font-size: 11.5px;
    font-weight: 700;
    color: #ffb15c;
    background: rgba(242, 147, 47, 0.1);
    padding: 3px 8px;
    border-radius: 4px;
    width: fit-content;
  }

  .import-banner {
    background: var(--surface);
    border: 1px dashed var(--line-2);
    border-radius: 8px;
    padding: 20px 24px;
    margin-top: 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .import-banner p {
    margin: 0;
    font-size: 14px;
    color: var(--text-2);
  }
  .import-link {
    color: var(--music-text);
    font-weight: 750;
    font-size: 13.5px;
    white-space: nowrap;
  }
  .import-link:hover {
    text-decoration: underline;
  }

  /* Features Grid */
  .features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    padding: 48px 0 64px;
  }
  .feature-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .feature-card:hover {
    border-color: #f2932f;
    transform: translateY(-3px);
  }
  .number {
    font-size: 13px;
    font-weight: 800;
    color: var(--music-text);
    letter-spacing: 0.08em;
    margin-bottom: 12px;
  }
  .feature-card h2 {
    font-size: 20px;
    line-height: 1.3;
    margin: 0 0 12px;
    color: var(--text);
  }
  .feature-card p {
    color: var(--text-3);
    font-size: 14.5px;
    line-height: 1.55;
    flex-grow: 1;
    margin: 0 0 20px;
  }
  .feature-card a {
    color: var(--music-text);
    font-weight: 700;
    font-size: 13.5px;
  }
  .feature-card a:hover {
    text-decoration: underline;
  }

  /* Companions Section */
  .companions-section {
    padding: 56px 0;
    border-top: 1px solid var(--line);
  }
  .companions-inner {
    background: linear-gradient(180deg, var(--bg) 0%, var(--bg) 100%);
    border: 1px solid rgba(242, 147, 47, 0.2);
    border-radius: 12px;
    padding: 52px 36px;
    text-align: center;
  }
  .companions-intro {
