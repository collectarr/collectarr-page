---
import ThemeHead from '../../../components/ThemeHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="What's new in Collectarr Games: latest software updates, hardware archiving, toys-to-life support, and valuation tools."
    />
    <title>What's New in Collectarr Games — Updates & Release Notes</title>
    <ThemeHead />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body class="games-page">
    <a class="skip" href="#main">Skip to content</a>
    <Header currentKind="games" activeSubNav="whatsnew" />

    <main id="main">
      <section class="whatsnew-hero">
        <p class="eyebrow">COLLECTARR GAMES UPDATES</p>
        <h1>What's new in Collectarr Games?</h1>
        <p class="intro">
          Discover the latest features, improvements, and fixes shipped in Collectarr Games,
          Hardware, and Toys-to-Life.
        </p>
      </section>

      <div class="updates-container">
        <!-- Update 1: Hardware & Toys -->
        <article class="update-card">
          <div class="update-meta">
            <span class="version-badge">Feature Release</span>
            <span class="date">October 2026</span>
          </div>
          <h2>Dedicated Hardware & Toys-to-Life Architecture</h2>
          <p class="summary">
            Games, Hardware, and Toys now operate with specialized, independent domain models, schemas, and Core catalog tables.
          </p>
          <ul class="update-points">
            <li><strong>Hardware Cataloging:</strong> Document home consoles, handheld systems, controllers, memory units, and peripheral accessories.</li>
            <li><strong>Local Serial Number Privacy:</strong> Serial numbers live purely in your local database and are never uploaded or synced publicly.</li>
            <li><strong>Toys-to-Life Figures:</strong> Catalog Amiibo, Skylanders, Disney Infinity, and interactive figurines with loose vs. boxed state and dual photo slots.</li>
            <li><strong>Dedicated List & Details:</strong> Hardware lists lead with platform icons and platform names before title.</li>
          </ul>
        </article>

        <!-- Update 2: Value & Completeness -->
        <article class="update-card">
          <div class="update-meta">
            <span class="version-badge">Valuation</span>
            <span class="date">October 2026</span>
          </div>
          <h2>Completeness Tiers & Packaging Value Recalculation</h2>
          <p class="summary">
            Seamlessly track Loose, Complete in Box (CIB), New / Sealed, Box only, and Manual only copies with automatic value calculations.
          </p>
          <ul class="update-points">
            <li><strong>Atomic Packaging Recalculation:</strong> Updating box or manual presence recalculates unlocked Loose values from recorded market snapshots.</li>
            <li><strong>PriceCharting Snapshot Support:</strong> Record historical price snapshots without subscription fees.</li>
            <li><strong>Custom Currency Settings:</strong> Prices honor your configured global currency setting (USD, EUR, GBP, JPY, etc.).</li>
          </ul>
        </article>

        <!-- Update 3: YouTube Trailers & Media -->
        <article class="update-card">
          <div class="update-meta">
            <span class="version-badge">Media</span>
            <span class="date">October 2026</span>
          </div>
          <h2>YouTube Trailer Links & Extended Cover Gallery</h2>
          <p class="summary">
            Enrich your video game entries with official trailer links and up to five high-resolution custom photos.
          </p>
          <ul class="update-points">
            <li><strong>YouTube Trailers:</strong> Add official trailer URLs and preview gameplay directly from the inspector panel.</li>
            <li><strong>Show Trailer Videos Setting:</strong> Easily toggle the trailer section on or off in Appearance Settings.</li>
            <li><strong>Up to 5 Custom Photos:</strong> Upload photos for cartridge labels, circuit boards, disc surfaces, and manuals.</li>
          </ul>
        </article>

        <!-- Update 4: Imports & Exports -->
        <article class="update-card">
          <div class="update-meta">
            <span class="version-badge">Import / Export</span>
            <span class="date">October 2026</span>
          </div>
          <h2>Lossless Native CSV & CLZ Games Import</h2>
          <p class="summary">
            Migrating from CLZ or spreadsheets is easier than ever with automatic header detection and loan creation.
          </p>
          <ul class="update-points">
            <li><strong>CLZ Games CSV / TXT Import:</strong> Auto-maps columns based on CLZ export headers (dates like "Nov 14, 2014", Yes/No flags, and prices).</li>
            <li><strong>Loan Import:</strong> Automatically generates loan records from Loaned To, Loan Date, and Due Date columns.</li>
            <li><strong>CLZ Web XML Import:</strong> Guided XML import with separate mappings for Games, Hardware, and Toys.</li>
          </ul>
        </article>
      </div>

      <section class="updates-cta">
        <p class="eyebrow">STAY UP TO DATE</p>
        <h2>Ready to explore the latest build?</h2>
        <p>Download the latest release for Windows, macOS, Linux, Android, or iOS from GitHub.</p>
        <div class="actions">
          <a class="primary" href="https://github.com/collectarr/collectarr-app/releases" target="_blank" rel="noopener">
            View Releases on GitHub ↗
          </a>
          <a class="secondary" href={`${base}games/`}>Back to Games Overview →</a>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  :global(*){box-sizing:border-box}
  :global(html){scroll-behavior:smooth}
  :global(body){margin:0;background:var(--bg);color:var(--text);font-family:"Segoe UI",system-ui,sans-serif;line-height:1.6}
  :global(a){color:inherit;text-decoration:none}
  :global(a:focus-visible){outline:3px solid #e23149;outline-offset:4px}
  :global(::selection){background:#e23149;color:#fff}

  .skip {
    position: fixed;
    top: -100px;
    left: 20px;
    padding: 10px 16px;
    background: #e23149;
    color: #fff;
    font-weight: 700;
    z-index: 1000;
  }
  .skip:focus { top: 15px; }

  main {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .whatsnew-hero {
    text-align: center;
    padding: 64px 16px 44px;
  }
  .eyebrow {
    font-size: 12px;
    letter-spacing: 0.14em;
    font-weight: 800;
    color: var(--games-text);
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .whatsnew-hero h1 {
    font-size: clamp(32px, 4vw, 54px);
    line-height: 1.15;
    letter-spacing: -0.04em;
    margin: 12px 0 16px;
  }
  .intro {
    font-size: 18px;
    color: var(--text-2);
    max-width: 650px;
    margin: 0 auto;
  }

  .updates-container {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-bottom: 64px;
  }
  .update-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 32px 28px;
    transition: border-color 0.2s ease;
  }
  .update-card:hover {
    border-color: #e23149;
  }
  .update-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }
  .version-badge {
    font-size: 10.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 3px 8px;
    border-radius: 4px;
    background: rgba(226, 49, 73, 0.15);
    color: #ff6075;
  }
  .date {
    font-size: 12.5px;
    color: var(--text-4);
  }
  .update-card h2 {
    font-size: 22px;
    margin: 0 0 10px;
    color: var(--text);
  }
  .summary {
    color: var(--text-3);
    font-size: 15px;
    margin: 0 0 18px;
  }
  .update-points {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .update-points li {
    font-size: 14px;
    color: var(--text-2);
    position: relative;
    padding-left: 20px;
  }
  .update-points li::before {
    content: '•';
    position: absolute;
    left: 4px;
    color: var(--games-text);
    font-size: 18px;
    line-height: 1.2;
  }
  .update-points strong {
    color: var(--text);
  }

  .updates-cta {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 48px 32px;
    text-align: center;
    margin-bottom: 80px;
  }
  .updates-cta h2 {
    font-size: clamp(24px, 2.8vw, 36px);
    margin: 10px 0 12px;
  }
  .updates-cta p {
    color: var(--text-2);
    margin: 0 auto 24px;
    max-width: 500px;
  }
  .actions {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .primary, .secondary {
    display: inline-flex;
    align-items: center;
    padding: 12px 22px;
    border-radius: 6px;
    font-weight: 750;
    font-size: 14px;
    transition: all 0.15s ease;
  }
  .primary {
    background: #e23149;
    color: #ffffff;
  }
  .primary:hover {
    background: #f93e56;
    transform: translateY(-2px);
  }
  .secondary {
    border: 1px solid var(--line-2);
    background: var(--surface);
  }
  .secondary:hover {
    background: var(--surface-2);
    transform: translateY(-2px);
  }
</style>
