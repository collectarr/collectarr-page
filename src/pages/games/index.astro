---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Collectarr Games is a dedicated video game library manager. Organize games, hardware, and toys-to-life figures with completeness tracking and valuation."
    />
    <title>Collectarr Games — Video Game & Hardware Collection Database</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body class="games-page">
    <a class="skip" href="#main">Skip to content</a>
    <Header currentKind="games" activeSubNav="overview" />

    <main id="main">
      <!-- Hero Section -->
      <section class="hero">
        <p class="eyebrow">VIDEO GAME DATABASE SOFTWARE</p>
        <h1>Catalog your<br /><span>game collection.</span></h1>
        <p class="intro">
          Keep track of your video game collection and wish list across every console generation.
          Use the mobile app on the go, the native desktop app at your computer, or self-host in your browser.
        </p>
        <div class="actions">
          <a class="primary" href="https://github.com/collectarr/collectarr-app/releases" target="_blank" rel="noopener">Explore Games releases ↗</a>
          <a class="secondary" href={`${base}manual/kinds/games/`}>Read Games user manual →</a>
          <a class="forum-btn" href="https://github.com/collectarr/collectarr-app/discussions?discussions_q=game" target="_blank" rel="noopener">Games Support Forum ↗</a>
        </div>
        <div class="availability-badges">
          <span class="badge">iOS & Android</span>
          <span class="badge">Windows, macOS & Linux</span>
          <span class="badge">Web & Docker</span>
          <span class="badge highlight">100% Free & Open-Source</span>
        </div>
      </section>

      <!-- 3 Cataloging Methods (How to Add) -->
      <section id="how-to-add" class="cataloging-methods">
        <div class="section-heading">
          <p class="eyebrow">EFFORTLESS CATALOGING</p>
          <h2>Three simple ways to build your game database</h2>
          <p>Whether you're cataloging ten games or ten thousand, Collectarr makes adding fast and accurate.</p>
        </div>

        <div class="methods-grid">
          <div class="method-card">
            <div class="method-num">01</div>
            <div class="method-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2" />
                <path d="M6 8v8m4-8v8m2-8v8m4-8v8m2-8v8" />
              </svg>
            </div>
            <h3>Scan Barcodes</h3>
            <p>
              Use your phone's camera, desktop webcam, or a USB barcode scanner to batch-scan cases.
              Instant matches download official cover art, publishers, developers, release dates, and genres.
            </p>
            <span class="method-tag">Fastest for retail games</span>
          </div>

          <div class="method-card">
            <div class="method-num">02</div>
            <div class="method-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="7" />
                <path d="m21 21-4.35-4.35" />
              </svg>
            </div>
            <h3>Search by Platform & Title</h3>
            <p>
              Type the game's title and filter by system (e.g. <em>SNES</em>, <em>Game Boy</em>, <em>PlayStation</em>).
              Preview covers, regional variants, and packaging before adding to your library with one click.
            </p>
            <span class="method-tag">Great for retro cartridges</span>
          </div>

          <div class="method-card">
            <div class="method-num">03</div>
            <div class="method-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 5v14M5 12h14" />
                <rect x="3" y="3" width="18" height="18" rx="2" />
              </svg>
            </div>
            <h3>Add Custom & Rare Items</h3>
            <p>
              Homebrew releases, unreleased prototypes, custom reproduction carts, and promotional kits.
              Add custom titles, upload your own photography, and define personalized custom fields.
            </p>
            <span class="method-tag">Infinite customization</span>
          </div>
        </div>

        <div class="import-banner">
          <p>
            <strong>Switching from CLZ Games or spreadsheets?</strong>
            Collectarr includes built-in importers for CLZ Games XML exports, text files, and CSV spreadsheets with automatic column mapping.
          </p>
          <a class="import-link" href={`${base}manual/import-export/`}>Learn about importing →</a>
        </div>
      </section>

      <!-- Features Grid -->
      <section class="features" aria-label="Collectarr Games features">
        <article class="feature-card">
          <span class="number">01</span>
          <h2>Multi-Platform Cataloging</h2>
          <p>
            Organize titles across PlayStation, Nintendo, Xbox, Sega, Atari, PC, and vintage microcomputers.
            Filter by platform folders, release years, developers, publishers, genres, and region codes.
          </p>
          <a href={`${base}manual/kinds/games/#platforms`}>Platform details →</a>
        </article>

        <article class="feature-card">
          <span class="number">02</span>
          <h2>Completeness & Condition</h2>
          <p>
            Track the exact physical reality of your copies: <strong>Loose</strong>, <strong>Complete in Box (CIB)</strong>,
            <strong>New / Sealed</strong>, <strong>Box only</strong>, or <strong>Manual only</strong>. Store packaging conditions and personal grades.
          </p>
          <a href={`${base}manual/kinds/games/#completeness`}>Completeness tiers →</a>
        </article>

        <article class="feature-card">
          <span class="number">03</span>
          <h2>Hardware & Accessories</h2>
          <p>
            Independent cataloging for game consoles, handhelds, controllers, memory cards, and special accessories.
            Record hardware models, personal serial numbers, and storage locations.
          </p>
          <a href={`${base}manual/kinds/games/#hardware`}>Hardware tracking →</a>
        </article>

        <article class="feature-card">
          <span class="number">04</span>
          <h2>Toys-to-Life Figures</h2>
          <p>
            Dedicated collections for Amiibo, Skylanders, Disney Infinity, and interactive figures.
            Keep track of series, figure variants, packaging status, and custom figure/box photography.
          </p>
          <a href={`${base}manual/kinds/games/#toys`}>Toys-to-life guide →</a>
        </article>

        <article class="feature-card">
          <span class="number">05</span>
          <h2>Valuation & Snapshots</h2>
          <p>
            Log purchase dates, purchase stores, and historical prices in your local currency.
            Record valuation snapshots without depending on proprietary cloud subscriptions.
          </p>
          <a href={`${base}manual/kinds/games/#valuation`}>Valuation workflows →</a>
        </article>

        <article class="feature-card">
          <span class="number">06</span>
          <h2>Trailers, Media & Covers</h2>
          <p>
            Save YouTube trailer links, developer links, high-res front/back cover art, and up to five
            additional photos per item for cartridges, circuit boards, and manual pages.
          </p>
          <a href={`${base}manual/images/`}>Images & media →</a>
        </article>
      </section>

      <!-- Companions Section (Mobile, Desktop & Web) -->
      <section class="companions-section">
        <div class="companions-inner">
          <p class="eyebrow">AVAILABLE EVERYWHERE</p>
          <h2>Mobile, Web & Desktop — perfect companions!</h2>
          <p class="companions-intro">
            Both Collectarr Mobile and Collectarr Desktop can be used entirely on their own as a standalone solution.
            But they truly shine when used together.
          </p>

          <div class="companions-grid">
            <div class="companion-box">
              <div class="companion-tag">While away from home</div>
              <h3>Collectarr Mobile</h3>
              <p>
                Browse your collection on your phone while crate digging at retro game stores, conventions, or flea markets.
                Never accidentally buy a duplicate cartridge again. Scan barcodes on the spot and add items directly.
              </p>
              <ul>
                <li>Quick handheld barcode scanning</li>
                <li>Offline database always in your pocket</li>
                <li>Wish list tracking to spot missing games</li>
              </ul>
            </div>

            <div class="companion-box">
              <div class="companion-tag">Back at your computer</div>
              <h3>Collectarr Desktop & Web</h3>
              <p>
                Use the full-screen desktop client for deep cataloging sessions, multi-column sorting, custom field configuration,
                bulk editing, and generating comprehensive collection valuation reports.
              </p>
              <ul>
                <li>High-density customizable table views</li>
                <li>Comprehensive backup & safe restore manager</li>
                <li>Keyboard shortcuts (<kbd>Ctrl+K</kbd>, <kbd>F1</kbd>) for lightning speed</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- Deep Dive Hardware & Toys -->
      <section id="hardware-toys" class="deep-dive">
        <div class="deep-dive-header">
          <p class="eyebrow">HARDWARE & TOYS INTEGRATION</p>
          <h2>More than just software discs.<br />The full gaming setup.</h2>
          <p>
            Video game collecting encompasses consoles, controllers, and figures. Collectarr handles
            hardware and toys as first-class domain models with dedicated schemas.
          </p>
        </div>

        <div class="grid-two">
          <div class="info-box">
            <div class="info-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 15.5 6 12h12l3 3.5V20H3Zm0 0h18M9 12V7m0 8.5V12" />
                <circle cx="9" cy="4.5" r="2.5" />
                <path d="M15 14h2m-9 4h4" />
              </svg>
            </div>
            <h3>Gaming Hardware</h3>
            <ul>
              <li><strong>Consoles & Handhelds:</strong> Track model numbers, firmware versions, and regional specifications.</li>
              <li><strong>Serial Number Privacy:</strong> Serial numbers live purely in your local database, never uploaded to public servers.</li>
              <li><strong>Controllers & Peripherals:</strong> Document controllers, racing wheels, VR headsets, and cables.</li>
              <li><strong>Dedicated Hardware List:</strong> Leads with platform icon and platform name before title.</li>
            </ul>
          </div>

          <div class="info-box">
            <div class="info-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="4" r="2.2" />
                <path d="m9 8-3 5 2 1 2-3v4l-1 4m6-11 3 5-2 1-2-3v4l1 4M9 8h6M6 19h12l2 3H4Z" />
              </svg>
            </div>
            <h3>Toys-to-Life</h3>
            <ul>
              <li><strong>Figure & Base Series:</strong> Group by game series (e.g. Smash Bros., Zelda, Splatoon, Skylanders Trap Team).</li>
              <li><strong>Loose vs. Boxed:</strong> Track loose figures vs. mint in original packaging.</li>
              <li><strong>Dedicated Photography:</strong> Dual image slots for Figure Image and Box Image.</li>
              <li><strong>Custom Folders:</strong> Browse your collection organized naturally by figure series.</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Why Choose Collectarr (Comparison table) -->
      <section class="comparison-section">
        <div class="section-heading">
          <p class="eyebrow">WHY COLLECTORS CHOOSE COLLECTARR</p>
          <h2>Local-first freedom vs. proprietary cloud lock-in</h2>
          <p>Built for collectors who want complete ownership over their databases without subscription paywalls.</p>
        </div>

        <div class="table-wrapper">
          <table class="comparison-table">
            <thead>
              <tr>
                <th>Capability</th>
                <th>Cloud Database Apps (CLZ)</th>
                <th>Collectarr Games</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Pricing</strong></td>
                <td>Paid subscription (€49.90 / year)</td>
                <td><span class="highlight-text">100% Free & Open-Source</span></td>
              </tr>
              <tr>
                <td><strong>Data Ownership</strong></td>
                <td>Trapped in vendor's cloud account</td>
                <td><span class="highlight-text">Local SQLite database on your device</span></td>
              </tr>
              <tr>
                <td><strong>Hardware & Consoles</strong></td>
                <td>Restricted by subscription tier</td>
                <td><span class="highlight-text">Full hardware & accessories schemas</span></td>
              </tr>
              <tr>
                <td><strong>Serial Number Privacy</strong></td>
                <td>Synced to commercial servers</td>
                <td><span class="highlight-text">Stored strictly locally on your machine</span></td>
              </tr>
              <tr>
                <td><strong>Completeness Recalculation</strong></td>
                <td>Fixed manual prices</td>
                <td><span class="highlight-text">Atomic packaging tier recalculation</span></td>
              </tr>
              <tr>
                <td><strong>Custom Fields</strong></td>
                <td>Paid tier restrictions</td>
                <td><span class="highlight-text">Unlimited typed custom fields</span></td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Community Reviews -->
      <section class="reviews-section">
        <div class="section-heading">
          <p class="eyebrow">REVIEWS FROM COLLECTORS</p>
          <h2>Loved by retro gamers & archivists</h2>
          <p>What fellow collectors say about managing their libraries with Collectarr.</p>
        </div>

        <div class="reviews-grid">
          <div class="review-card">
            <div class="stars">★★★★★</div>
            <p>"Having separate hardware and toys-to-life tracking without paying an annual subscription fee is exactly what the video game collecting community needed."</p>
            <span class="reviewer">— Retro Gaming Archivist</span>
          </div>
          <div class="review-card">
            <div class="stars">★★★★★</div>
            <p>"The completeness states (Loose, CIB, Box only) actually match how physical collectors organize cartridges. And knowing my serial numbers stay private is huge."</p>
            <span class="reviewer">— Console & Cartridge Collector</span>
          </div>
          <div class="review-card">
            <div class="stars">★★★★★</div>
            <p>"Imported my old CLZ export in seconds. Everything—from purchase dates to YouTube trailers—worked seamlessly offline."</p>
            <span class="reviewer">— Multi-Platform Collector</span>
          </div>
        </div>
      </section>

      <!-- Callout / Support CTA -->
      <section id="completeness-value" class="callout-section">
        <div class="callout-inner">
          <p class="eyebrow">COMMUNITY & SUPPORT</p>
          <h2>Join the Collectarr Games discussions</h2>
          <p>
            Have ideas for gaming platform fields, PriceCharting integrations, or hardware tracking?
            Discuss with other collectors in the dedicated GitHub Discussions forum.
          </p>
          <div class="actions">
            <a class="primary" href="https://github.com/collectarr/collectarr-app/discussions?discussions_q=game" target="_blank" rel="noopener">
              Open Games Support Forum ↗
            </a>
            <a class="secondary" href={`${base}contact/?kind=games`}>
              Contact & Diagnostics Hub →
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  :global(*){box-sizing:border-box}
  :global(html){scroll-behavior:smooth}
  :global(body){margin:0;background:#141517;color:#f6f3ed;font-family:"Segoe UI",system-ui,sans-serif;line-height:1.6}
  :global(a){color:inherit;text-decoration:none}
  :global(a:focus-visible){outline:3px solid #e23149;outline-offset:4px}
  :global(::selection){background:#e23149;color:#fff}

  .skip {
    position: fixed;
    top: -100px;
    left: 20px;
    padding: 10px 16px;
    background: #e23149;
    color: #fff;
    font-weight: 700;
    z-index: 1000;
  }
  .skip:focus { top: 15px; }

  main {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Hero */
  .hero {
    text-align: center;
    padding: 68px 16px 48px;
    max-width: 920px;
    margin: 0 auto;
  }
  .eyebrow {
    font-size: 12px;
    letter-spacing: 0.14em;
    font-weight: 800;
    color: #e23149;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .hero h1 {
    font-size: clamp(36px, 5vw, 68px);
    line-height: 1.1;
    letter-spacing: -0.04em;
    margin: 14px 0 20px;
  }
  .hero h1 span {
    color: #e23149;
  }
  .intro {
    font-size: 18.5px;
    line-height: 1.55;
    color: #c4c7cc;
    max-width: 740px;
    margin: 0 auto 30px;
  }
  .actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  .primary, .secondary, .forum-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    padding: 12px 22px;
    font-weight: 750;
    font-size: 14px;
    transition: transform 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
  }
  .primary {
    background: #e23149;
    color: #ffffff;
  }
  .primary:hover {
    background: #f93e56;
    transform: translateY(-2px);
  }
  .secondary {
    border: 1px solid #4a4d52;
    background: #1e2023;
    color: #f6f3ed;
  }
  .secondary:hover {
    background: #2b2e33;
    border-color: #727780;
    transform: translateY(-2px);
  }
  .forum-btn {
    border: 1px solid rgba(226, 49, 73, 0.4);
    background: rgba(226, 49, 73, 0.08);
    color: #f95a6f;
  }
  .forum-btn:hover {
    background: rgba(226, 49, 73, 0.18);
    transform: translateY(-2px);
  }

  .availability-badges {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 10px;
  }
  .availability-badges .badge {
    font-size: 11px;
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 4px 10px;
    border-radius: 4px;
    background: #1f2227;
    color: #9ea3a8;
    border: 1px solid #2d3138;
  }
  .availability-badges .badge.highlight {
    background: rgba(226, 49, 73, 0.15);
    color: #ff6075;
    border-color: rgba(226, 49, 73, 0.3);
  }

  /* Cataloging Methods (How to Add) */
  .cataloging-methods {
    padding: 64px 0 48px;
    border-top: 1px solid #25282c;
  }
  .section-heading {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 44px;
  }
  .section-heading h2 {
    font-size: clamp(28px, 3.5vw, 42px);
    line-height: 1.2;
    letter-spacing: -0.03em;
    margin: 10px 0 14px;
  }
  .section-heading p {
    color: #a8acb2;
    font-size: 16px;
  }
  .methods-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .method-card {
    background: #191b1e;
    border: 1px solid #282b30;
    border-radius: 10px;
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: all 0.2s ease;
  }
  .method-card:hover {
    border-color: #e23149;
    transform: translateY(-2px);
  }
  .method-num {
    font-size: 13px;
    font-weight: 800;
    color: #e23149;
    letter-spacing: 0.08em;
    margin-bottom: 12px;
  }
  .method-icon {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    background: rgba(226, 49, 73, 0.12);
    color: #e23149;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
  }
  .method-icon svg {
    width: 24px;
    height: 24px;
  }
  .method-card h3 {
    font-size: 19px;
    margin: 0 0 10px;
    color: #f6f3ed;
  }
  .method-card p {
    color: #a8acb2;
    font-size: 14px;
    line-height: 1.55;
    margin: 0 0 18px;
    flex-grow: 1;
  }
  .method-tag {
    font-size: 11.5px;
    font-weight: 700;
    color: #ff6075;
    background: rgba(226, 49, 73, 0.1);
    padding: 3px 8px;
    border-radius: 4px;
    width: fit-content;
  }

  .import-banner {
    background: #1b1d20;
    border: 1px dashed #3a3f47;
    border-radius: 8px;
    padding: 20px 24px;
    margin-top: 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .import-banner p {
    margin: 0;
    font-size: 14px;
    color: #c4c7cc;
  }
  .import-link {
    color: #e23149;
    font-weight: 750;
    font-size: 13.5px;
    white-space: nowrap;
  }
  .import-link:hover {
    text-decoration: underline;
  }

  /* Features Grid */
  .features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    padding: 48px 0 64px;
  }
  .feature-card {
    background: #1a1c1f;
    border: 1px solid #282b30;
    border-radius: 8px;
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .feature-card:hover {
    border-color: #e23149;
    transform: translateY(-3px);
  }
  .number {
    font-size: 13px;
    font-weight: 800;
    color: #e23149;
    letter-spacing: 0.08em;
    margin-bottom: 12px;
  }
  .feature-card h2 {
    font-size: 20px;
    line-height: 1.3;
    margin: 0 0 12px;
    color: #f6f3ed;
  }
  .feature-card p {
    color: #a8acb2;
    font-size: 14.5px;
    line-height: 1.55;
    flex-grow: 1;
    margin: 0 0 20px;
  }
  .feature-card a {
    color: #e23149;
    font-weight: 700;
    font-size: 13.5px;
  }
  .feature-card a:hover {
    text-decoration: underline;
  }

  /* Companions Section */
  .companions-section {
    padding: 56px 0;
    border-top: 1px solid #25282c;
  }
  .companions-inner {
    background: linear-gradient(180deg, #1c1a1b 0%, #151618 100%);
    border: 1px solid rgba(226, 49, 73, 0.2);
    border-radius: 12px;
    padding: 52px 36px;
    text-align: center;
  }
  .companions-intro {
    max-width: 680px;
    margin: 12px auto 36px;
    font-size: 16px;
    color: #c4c7cc;
  }
  .companions-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    text-align: left;
  }
  .companion-box {
    background: #17181a;
    border: 1px solid #282a2e;
    border-radius: 8px;
    padding: 28px 24px;
  }
  .companion-tag {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #e23149;
    margin-bottom: 6px;
  }
  .companion-box h3 {
    font-size: 20px;
    margin: 0 0 12px;
    color: #f6f3ed;
  }
