---
import { Image } from 'astro:assets';
import workspace from '../assets/screenshots/library.png';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const kinds = ['Music', 'Books', 'Comics', 'Manga', 'Movies', 'TV', 'Anime', 'Games', 'Board Games'];
const kindPaths = ['music', 'book', 'comic', 'manga', 'movie', 'tv', 'anime', 'game', 'boardgame'];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Collectarr is a local-first collection manager for music, books, comics, games and more. Explore the app and its shared user manual." />
    <title>Collectarr — A home for your collections</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header>
      <a class="brand" href={base}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18v4H3zm0 6h8v8H3zm10 0h8v8h-8z" fill="currentColor" /></svg> COLLECTARR</a>
      <nav aria-label="Main navigation"><a href="#collections">Collections</a><a href={`${base}manual/`}>User manual</a><a href="https://github.com/collectarr/collectarr-app">GitHub ↗</a></nav>
    </header>
    <main id="main">
      <section class="hero">
        <p class="eyebrow">FOR THE THINGS YOU LOVE TO COLLECT</p>
        <h1>Every collection.<br /><span>One place to call home.</span></h1>
        <p class="intro">Music, books, comics, games and more. Keep track of what you own, find the details that matter, and make your library yours.</p>
        <div class="actions"><a class="primary" href="https://github.com/collectarr/collectarr-app/releases">Explore releases ↗</a><a class="secondary" href={`${base}manual/getting-started/`}>Get started with the manual →</a></div>
        <p class="note">Local-first · Open source · Currently in beta</p>
        <figure class="workspace"><Image src={workspace} alt="The Collectarr Music workspace showing fictional demo albums, collection folders and the details inspector" loading="eager" /><figcaption>The Music workspace. Demonstration data; your library stays yours.</figcaption></figure>
      </section>
      <section class="features" aria-label="What Collectarr does">
        <article><span class="number">01</span><h2>Your collection, your data</h2><p>Personal entries live locally. Use Core for catalog metadata and configure optional personal sync when you need it.</p><a href={`${base}manual/backup-sync/`}>Data, backup & sync →</a></article>
        <article><span class="number">02</span><h2>Details worth keeping</h2><p>Track editions, condition, locations and purchases. Add covers, personal images and custom fields for what matters to you.</p><a href={`${base}manual/editing/`}>Editing your entries →</a></article>
        <article><span class="number">03</span><h2>A library that fits you</h2><p>Choose views, columns and sorting. Organize named collections and browse folders derived from your actual field values.</p><a href={`${base}manual/browsing/`}>Explore your library →</a></article>
      </section>
      <section id="collections" class="collections"><div><p class="eyebrow">NINE KINDS. ONE FAMILIAR WORKSPACE.</p><h2>Different collections.<br />The details they deserve.</h2><p>Shared controls where the workflow is the same. Kind-specific fields and editors where it isn't.</p></div><div class="kinds">{kinds.map((kind, i) => <a href={`${base}manual/kinds/${kindPaths[i]}/`}><span>{kind}</span><span aria-hidden="true">↗</span></a>)}</div></section>
      <section class="guide"><p class="eyebrow">A LITTLE HELP, WHEN YOU NEED IT</p><h2>From your first entry<br />to your next thousand.</h2><p>One searchable manual, with common workflows and a chapter for each kind. No need to learn everything nine times.</p><a class="primary" href={`${base}manual/`}>Open the user manual →</a></section>
    </main>
    <footer><a class="brand" href={base}>COLLECTARR</a><p>An open-source collection manager. Independent of CLZ.</p><a href="https://github.com/collectarr/collectarr-app/issues">Feedback & issues ↗</a></footer>
  </body>
</html>
<style>
  :global(*){box-sizing:border-box} :global(html){scroll-behavior:smooth} :global(body){margin:0;background:#17191a;color:#f6f3ed;font-family:"Segoe UI",system-ui,sans-serif;line-height:1.6} :global(a){color:inherit;text-decoration:none} :global(a:focus-visible){outline:3px solid #f3a457;outline-offset:5px} :global(::selection){background:#f3a457;color:#17191a}
  header,main,footer{max-width:1240px;margin:auto}header{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:28px 32px;border-bottom:1px solid #343637}.brand{font-size:20px;font-weight:850;letter-spacing:.07em;display:flex;gap:10px;align-items:center}.brand svg{width:24px;height:24px;color:#f3a457}nav{display:flex;gap:28px;font-size:14px;font-weight:600}nav a:hover,footer a:hover{color:#f3a457}.skip{position:fixed;top:-100px;left:20px;padding:10px;background:#f3a457;color:#17191a;z-index:100}.skip:focus{top:10px}
  .hero{text-align:center;padding:72px 32px 36px}.eyebrow{font-size:12px;letter-spacing:.14em;font-weight:750;color:#f3a457}.hero h1{font-size:clamp(38px,5vw,68px);line-height:1.12;letter-spacing:-.045em;margin:24px 0}.hero h1 span{color:#f3a457}.intro{max-width:650px;margin:24px auto 30px;font-size:19px;color:#bbb9b3}.actions{display:flex;justify-content:center;gap:14px;flex-wrap:wrap}.primary,.secondary{display:inline-flex;align-items:center;justify-content:center;border-radius:7px;padding:12px 20px;font-weight:700;font-size:14px;transition:background .15s,transform .15s}.primary{background:#f3a457;color:#17191a}.primary:hover{background:#ffd2a2;transform:translateY(-2px)}.secondary{border:1px solid #56514a}.secondary:hover{background:#2b2c2d}.note{color:#aaa8a1;font-size:12px;margin:20px 0 36px}.workspace{margin:0}.workspace img{display:block;width:100%;height:auto;border:1px solid #544436;border-radius:10px;box-shadow:0 24px 60px #0005}.workspace figcaption{font-size:12px;color:#aaa8a1;margin-top:14px}
  .features{display:grid;grid-template-columns:repeat(3,1fr);gap:36px;padding:48px 32px 64px}.features article{padding-top:24px;border-top:1px solid #45433e}.number{color:#f3a457;font-size:13px}.features h2{font-size:22px;line-height:1.3}.features p,.collections p,.guide p:not(.eyebrow){color:#bbb9b3}.features a{color:#f3a457;font-size:14px;font-weight:650}.features a:hover{text-decoration:underline}.collections{display:grid;grid-template-columns:1fr 1fr;gap:64px;padding:64px 32px;border-top:1px solid #343637}.collections h2,.guide h2{font-size:clamp(30px,3.5vw,44px);line-height:1.2;letter-spacing:-.03em}.kinds{display:grid;grid-template-columns:1fr 1fr;gap:10px}.kinds a{display:flex;justify-content:space-between;align-items:center;padding:15px 18px;border:1px solid #44443f;border-radius:6px;font-weight:650}.kinds a:hover{background:#352b22;border-color:#f3a457}.kinds a span:last-child{color:#f3a457}.guide{text-align:center;padding:60px 32px 80px;background:#222323;border-radius:12px;margin:24px 32px 64px}.guide p:not(.eyebrow){max-width:580px;margin:20px auto 30px}footer{padding:32px;display:flex;align-items:center;justify-content:space-between;gap:20px;border-top:1px solid #343637;font-size:12px;color:#aaa8a1}footer .brand{font-size:15px;color:#f6f3ed}
  @media(max-width:700px){header{padding:20px;align-items:flex-start;flex-direction:column;gap:14px}nav{gap:20px;flex-wrap:wrap}.hero{padding:44px 20px 20px}.intro{font-size:17px}.features{grid-template-columns:1fr;gap:18px;padding:30px 20px}.collections{grid-template-columns:1fr;gap:24px;padding:35px 20px}.guide{margin:20px;padding:35px 20px}.actions>a{width:100%}footer{padding:24px 20px;align-items:flex-start;flex-direction:column}}
  @media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}.primary,.secondary{transition:none}.primary:hover{transform:none}}
</style>
