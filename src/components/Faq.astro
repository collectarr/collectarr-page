---
interface Props {
  eyebrow?: string;
  title: string;
  items: { q: string; a: string }[];
}
const { eyebrow = 'FREQUENTLY ASKED QUESTIONS', title, items } = Astro.props;
---

<section id="faq" class="faq-section">
  <div class="faq-heading">
    <p class="faq-eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
  </div>
  <div class="faq-list">
    {items.map((item) => (
      <details class="faq-item">
        <summary>{item.q}</summary>
        <p>{item.a}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .faq-section {
    padding: 56px 0 64px;
    border-top: 1px solid var(--line);
    max-width: 820px;
    margin: 0 auto;
  }
  .faq-heading { text-align: center; margin-bottom: 28px; }
  .faq-eyebrow {
    font-size: 12px;
    letter-spacing: 0.14em;
    font-weight: 800;
    color: var(--accent-text);
    margin: 0 0 10px;
  }
  .faq-heading h2 {
    font-size: clamp(26px, 3.2vw, 38px);
    letter-spacing: -0.03em;
    margin: 0;
  }
  .faq-item {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    margin-bottom: 10px;
  }
  .faq-item summary {
    cursor: pointer;
    list-style: none;
    padding: 16px 48px 16px 20px;
    font-weight: 700;
    font-size: 15.5px;
    position: relative;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after {
    content: '+';
    position: absolute;
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 22px;
    color: var(--accent-text);
  }
  .faq-item[open] summary::after { content: '−'; }
  .faq-item p {
    margin: 0;
    padding: 0 20px 18px;
    color: var(--text-3);
    font-size: 14.5px;
    line-height: 1.6;
  }
</style>
