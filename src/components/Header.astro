---
interface Props {
  currentKind?: 'home' | 'music' | 'games' | 'comics' | 'movies' | 'books' | 'contact';
  activeSubNav?: string;
}

const { currentKind = 'home', activeSubNav = 'overview' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';

interface KindDef {
  id: 'comics' | 'movies' | 'games' | 'music' | 'books';
  label: string;
  href: string;
  color: string;
  lightColor: string;
  isAvailable: boolean;
  statusBadge?: string;
  discussionsUrl: string;
}

const kinds: KindDef[] = [
  {
    id: 'comics',
    label: 'Comics',
    href: `${base}#upcoming`,
    color: '#00AEE6',
    lightColor: '#3BC0EA',
    isAvailable: false,
    statusBadge: 'Planned',
    discussionsUrl: 'https://github.com/collectarr/collectarr-app/discussions',
  },
  {
    id: 'movies',
    label: 'Movies',
    href: `${base}#upcoming`,
    color: '#3BAC4B',
    lightColor: '#4DCC5F',
    isAvailable: false,
    statusBadge: 'Planned',
    discussionsUrl: 'https://github.com/collectarr/collectarr-app/discussions',
  },
  {
    id: 'games',
    label: 'Games',
    href: `${base}games/`,
    color: '#E23149',
    lightColor: '#F93E56',
    isAvailable: true,
    discussionsUrl: 'https://github.com/collectarr/collectarr-app/discussions?discussions_q=game',
  },
  {
    id: 'music',
    label: 'Music',
    href: `${base}music/`,
    color: '#F2932F',
    lightColor: '#FFAC33',
    isAvailable: true,
    discussionsUrl: 'https://github.com/collectarr/collectarr-app/discussions?discussions_q=music',
  },
  {
    id: 'books',
    label: 'Books',
    href: `${base}#upcoming`,
    color: '#9B6296',
    lightColor: '#BD71B9',
    isAvailable: false,
    statusBadge: 'Planned',
    discussionsUrl: 'https://github.com/collectarr/collectarr-app/discussions',
  },
];

const activeKindObj = kinds.find((k) => k.id === currentKind);
const themeColor = activeKindObj ? activeKindObj.color : currentKind === 'contact' ? '#2c3035' : '#1f2327';
const supportForumUrl = activeKindObj ? activeKindObj.discussionsUrl : 'https://github.com/collectarr/collectarr-app/discussions';
const contactUrl = activeKindObj ? `${base}contact/?kind=${activeKindObj.id}` : `${base}contact/`;
---

<header class="site-header" style={`--active-theme-color: ${themeColor};`}>
  <!-- Top Navigation Bar with Kind Switcher -->
  <nav id="top-nav" aria-label="Product navigation">
    <div class="top-nav-inner">
      <div class="brand-col">
        <a class="brand" href={base} title="Collectarr Home">
          <svg viewBox="0 0 24 24" aria-hidden="true" class="brand-icon">
            <path d="M3 5h18v4H3zm0 6h8v8H3zm10 0h8v8h-8z" fill="currentColor" />
          </svg>
          <span class="brand-text">COLLECTARR</span>
        </a>
      </div>

      <div class="app-nav">
        {kinds.map((kind) => {
          const isSelected = currentKind === kind.id;
          return (
            <a
              href={kind.href}
              class={`app-item app-item-${kind.id} ${isSelected ? 'app-item-selected' : ''} ${!kind.isAvailable ? 'app-item-preview' : ''}`}
              style={`--kind-color: ${kind.color}; --kind-light: ${kind.lightColor};`}
              aria-current={isSelected ? 'page' : undefined}
              title={kind.isAvailable ? `Collectarr ${kind.label}` : `Collectarr ${kind.label} (${kind.statusBadge})`}
            >
              <div class="app-icon-wrapper">
                {kind.id === 'comics' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="kind-svg">
                    <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v17H6.5A2.5 2.5 0 0 0 4 22.5Z" />
                    <path d="M4 5.5V22.5M8 7h8M8 11h8M8 15h5" />
                  </svg>
                )}
                {kind.id === 'movies' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="kind-svg">
                    <rect x="3" y="5" width="18" height="15" rx="2" />
                    <path d="M3 10h18M8 5l2 5M14 5l2 5M7 15h1m4 0h1m4 0h1" />
                  </svg>
                )}
                {kind.id === 'games' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="kind-svg">
                    <path d="M8 7h8c3 0 4.2 2.1 5.2 6.8.8 3.7-1.4 5.3-3.5 3.1L15 14H9l-2.7 2.9c-2.1 2.2-4.3.6-3.5-3.1C3.8 9.1 5 7 8 7Z" />
                    <path d="M12 7V4h3M6 10v4m-2-2h4" />
                    <circle cx="16" cy="10.5" r=".75" fill="currentColor" stroke="none" />
                    <circle cx="18.5" cy="12.5" r=".75" fill="currentColor" stroke="none" />
                  </svg>
                )}
                {kind.id === 'music' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="kind-svg">
                    <circle cx="12" cy="12" r="9" />
                    <circle cx="12" cy="12" r="3" />
                    <path d="M12 3v3m0 12v3M3 12h3m12 0h3" />
                    <circle cx="12" cy="12" r=".75" fill="currentColor" stroke="none" />
                  </svg>
                )}
                {kind.id === 'books' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="kind-svg">
                    <path d="M3 19a9 9 0 0 1 9 0 9 9 0 0 1 9 0M3 6a9 9 0 0 1 9 0 9 9 0 0 1 9 0v13a9 9 0 0 0-9 0 9 9 0 0 0-9 0Z" />
                    <path d="M12 6v13" />
                  </svg>
                )}
              </div>
              <span class="app-title">
                <span class="txt-prefix">Collectarr</span>
                <span class="txt-name">{kind.label}</span>
              </span>
              {kind.statusBadge && <span class="badge-tag">{kind.statusBadge}</span>}
            </a>
          );
        })}
      </div>
    </div>
  </nav>

  <!-- Sub-Navigation Bar -->
  <nav id="sub-nav" aria-label="Sub navigation">
    <div class="sub-nav-inner">
      <div class="nav-group nav-group-left">
        {currentKind === 'games' && (
          <>
            <a href={`${base}games/`} class={activeSubNav === 'overview' ? 'active' : ''}>Overview</a>
            <a href={`${base}games/#hardware-toys`} class={activeSubNav === 'hardware' ? 'active' : ''}>Hardware & Toys</a>
            <a href={`${base}games/#completeness-value`} class={activeSubNav === 'value' ? 'active' : ''}>Completeness & Value</a>
            <a href={`${base}manual/kinds/games/`} class={activeSubNav === 'manual' ? 'active' : ''}>Manual</a>
          </>
        )}
        {currentKind === 'music' && (
          <>
            <a href={`${base}music/`} class={activeSubNav === 'overview' ? 'active' : ''}>Overview</a>
            <a href={`${base}music/#formats`} class={activeSubNav === 'formats' ? 'active' : ''}>Formats & Discs</a>
            <a href={`${base}music/#tracks-credits`} class={activeSubNav === 'credits' ? 'active' : ''}>Tracks & Credits</a>
            <a href={`${base}manual/kinds/music/`} class={activeSubNav === 'manual' ? 'active' : ''}>Manual</a>
          </>
        )}
        {currentKind === 'contact' && (
          <>
            <a href={base}>Home</a>
            <a href={`${base}contact/`} class="active">Contact Support</a>
            <a href={`${base}manual/`}>User manual</a>
          </>
        )}
        {currentKind === 'home' && (
          <>
            <a href={base} class="active">Home</a>
            <a href={`${base}#collections`}>Collections</a>
            <a href={`${base}manual/`}>User manual</a>
            <a href="https://github.com/collectarr/collectarr-app" target="_blank" rel="noopener">GitHub ↗</a>
          </>
        )}
      </div>

      <div class="nav-group nav-group-right">
        <a href={supportForumUrl} target="_blank" rel="noopener" class="forum-link">Support Forum ↗</a>
        <a href={contactUrl} class={currentKind === 'contact' ? 'active' : ''}>Contact</a>
      </div>
    </div>
  </nav>
</header>

<style>
  .site-header {
    width: 100%;
    position: relative;
    z-index: 50;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }

  /* Top Nav */
  #top-nav {
    background: #111315;
    border-bottom: 1px solid #25282c;
  }

  .top-nav-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    min-height: 84px;
  }

  .brand-col {
    display: flex;
    align-items: center;
    padding-right: 20px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #f6f3ed;
    font-size: 19px;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .brand:hover {
    color: #ffd2a2;
  }

  .brand-icon {
    width: 26px;
    height: 26px;
    color: #f3a457;
  }

  /* App Nav Switcher */
  .app-nav {
    display: flex;
    align-items: stretch;
    gap: 6px;
  }

  .app-item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 10px 16px;
    min-width: 86px;
    text-decoration: none;
    color: #9ea3a8;
    transition: color 0.18s ease, transform 0.18s ease, background-color 0.18s ease;
    z-index: 2;
  }

  .app-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    margin-bottom: 4px;
    transition: transform 0.18s ease, filter 0.18s ease;
  }

  .kind-svg {
    width: 26px;
    height: 26px;
    stroke: currentColor;
    transition: stroke 0.18s ease, transform 0.18s ease;
  }

  .app-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0.02em;
    text-align: center;
  }

  .txt-prefix {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
    opacity: 0.7;
    text-transform: uppercase;
  }

  .txt-name {
    font-size: 13px;
  }

  .badge-tag {
    position: absolute;
    top: 6px;
    right: 6px;
    font-size: 8.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 1px 5px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.08);
    color: #888d92;
  }

  /* Hover state */
  .app-item:hover {
    color: #fff;
    transform: translateY(-2px);
  }

  .app-item:hover .kind-svg {
    stroke: var(--kind-light);
    filter: drop-shadow(0 0 6px var(--kind-color));
  }

  .app-item:hover .txt-name {
    color: var(--kind-light);
  }

  /* Selected state with angled CLZ-inspired gradient slash */
  .app-item.app-item-selected {
    color: #ffffff;
    background-color: var(--kind-color);
  }

  .app-item.app-item-selected .kind-svg {
    stroke: #ffffff;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.4));
  }

  .app-item.app-item-selected .txt-prefix {
    color: rgba(255, 255, 255, 0.85);
  }

  .app-item.app-item-selected .txt-name {
    color: #ffffff;
    font-weight: 800;
  }

  /* Sub Nav Bar */
  #sub-nav {
    background-color: var(--active-theme-color);
    transition: background-color 0.25s ease;
  }

  .sub-nav-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 48px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .sub-nav-inner::-webkit-scrollbar {
    display: none;
  }

  .nav-group {
    display: flex;
    align-items: center;
    gap: 28px;
    white-space: nowrap;
  }

  .nav-group a {
    color: #ffffff;
    text-transform: uppercase;
    text-decoration: none;
    font-size: 13px;
    font-weight: 750;
    letter-spacing: 0.06em;
    padding: 12px 0;
    position: relative;
    opacity: 0.92;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .nav-group a:hover {
    opacity: 1;
    transform: translateY(-1px);
  }

  .nav-group a.active {
    opacity: 1;
    font-weight: 850;
  }

  .nav-group a.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: #ffffff;
    border-radius: 2px 2px 0 0;
  }

  .forum-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  /* Responsive styles */
  @media (max-width: 900px) {
    .top-nav-inner {
      padding: 0 16px;
    }

    .app-item {
      padding: 8px 10px;
      min-width: 72px;
    }

    .txt-prefix {
      display: none;
    }

    .nav-group {
      gap: 18px;
    }
  }

  @media (max-width: 680px) {
    .top-nav-inner {
      flex-direction: column;
      align-items: stretch;
      padding: 12px 14px 6px;
    }

    .brand-col {
      padding-bottom: 10px;
      justify-content: center;
    }

    .app-nav {
      justify-content: space-around;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .app-nav::-webkit-scrollbar {
      display: none;
    }

    .app-item {
      min-width: 60px;
      padding: 6px 8px;
    }

    .app-icon-wrapper {
      width: 28px;
      height: 28px;
      margin-bottom: 2px;
    }

    .kind-svg {
      width: 22px;
      height: 22px;
    }

    .txt-name {
      font-size: 11px;
    }

    .badge-tag {
      display: none;
    }

    .sub-nav-inner {
      padding: 0 14px;
      gap: 16px;
    }

    .nav-group {
      gap: 14px;
    }

    .nav-group a {
      font-size: 11.5px;
      padding: 10px 0;
    }
  }
</style>
