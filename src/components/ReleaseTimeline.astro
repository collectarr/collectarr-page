---
import { releases, releaseUrl, releasesUrl } from '../data/releases';
---

<div class="timeline-head">
  <label class="filter">
    <span class="sr-only">Show</span>
    <select id="release-filter">
      <option value="all">All updates</option>
      <option value="features">Features only</option>
      <option value="fixes">Fixes only</option>
    </select>
  </label>
</div>

<div class="timeline-layout">
  <div class="releases">
    {releases.map((r, i) => (
      <article class="release" id={`v${r.version}`}>
        <header class="release-head">
          <div class="product">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <circle cx="12" cy="12" r="3" />
              <path d="M12 3v3m0 12v3M3 12h3m12 0h3" />
            </svg>
            <span>Collectarr Music</span>
            {i === 0 && <span class="latest-badge">Latest</span>}
          </div>
          <h2><a href={`#v${r.version}`}>v{r.version}: {r.title}</a></h2>
          <div class="date">{r.date}</div>
        </header>
        <p class="summary">{r.summary}</p>
        {r.notice && (
          <p class="notice"><strong>Good to know:</strong> {r.notice}</p>
        )}
        <section data-section="features">
          <h3>Features</h3>
          <ul>{r.features.map((f) => <li>{f}</li>)}</ul>
        </section>
        <section data-section="fixes">
          <h3>Highlighted fixes</h3>
          <ul>{r.fixes.map((f) => <li>{f}</li>)}</ul>
        </section>
        <a class="read-more" href={releaseUrl(r.version)} target="_blank" rel="noopener">
          Full release notes & downloads ↗
        </a>
        <footer class="release-foot">
          <span class="tags">{r.tags.map((t) => <span class="tag">{t}</span>)}</span>
          <span class="platforms">Windows, Linux, macOS, Android and a web bundle{r.docker ? ' · Docker image' : ''}</span>
        </footer>
      </article>
    ))}
  </div>

  <aside class="recent" aria-label="Recent changes">
    <h2>Recent changes</h2>
    <ol>
      {releases.map((r) => (
        <li>
          <a href={`#v${r.version}`}>
            <span class="r-title">v{r.version}: {r.title}</span>
            <span class="r-date">{r.date}</span>
          </a>
        </li>
      ))}
    </ol>
    <p class="recent-note">
      Earlier 0.x builds were prototypes and are not listed. Every download is on{' '}
      <a href={releasesUrl} target="_blank" rel="noopener">GitHub Releases ↗</a>.
    </p>
  </aside>
</div>

<script>
  const select = document.querySelector<HTMLSelectElement>('#release-filter');
  select?.addEventListener('change', () => {
    document.querySelectorAll<HTMLElement>('[data-section]').forEach((el) => {
      el.hidden = select.value !== 'all' && el.dataset.section !== select.value;
    });
  });
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .timeline-head { display: flex; justify-content: flex-end; margin-bottom: 16px; }
  .filter select {
    font: inherit;
    font-size: 14px;
    font-weight: 650;
    padding: 9px 36px 9px 16px;
    border-radius: 6px;
    border: 1px solid var(--line-2);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }
  .timeline-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 32px;
    align-items: start;
    padding-bottom: 64px;
  }

  .releases { display: flex; flex-direction: column; gap: 24px; }
  .release {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 24px 28px 20px;
    scroll-margin-top: 20px;
  }
  .release-head { padding-bottom: 14px; border-bottom: 1px solid var(--line); margin-bottom: 16px; }
  .product {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    font-weight: 750;
    color: var(--music-text);
    margin-bottom: 6px;
  }
  .product svg { width: 20px; height: 20px; }
  .latest-badge {
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 2px 7px;
    border-radius: 4px;
    background: var(--music-text);
    color: var(--bg);
  }
  .release h2 { font-size: 22px; line-height: 1.3; margin: 0 0 4px; }
  .release h2 a:hover { color: var(--music-text); }
  .date { font-size: 12.5px; color: var(--text-4); }
  .summary { color: var(--text-3); font-size: 15px; margin: 0 0 16px; }
  .notice {
    background: var(--surface-2);
    border-left: 3px solid var(--music-text);
    border-radius: 4px;
    padding: 12px 14px;
    font-size: 13.5px;
    color: var(--text-2);
    margin: 0 0 8px;
  }
  .release section[hidden] { display: none; }
  .release h3 {
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
    margin: 20px 0 10px;
  }
  .release ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 9px; }
  .release li {
    font-size: 14px;
    color: var(--text-2);
    position: relative;
    padding-left: 20px;
  }
  .release li::before {
    content: '•';
    position: absolute;
    left: 4px;
    color: var(--music-text);
    font-size: 18px;
    line-height: 1.2;
  }
  .read-more {
    display: inline-block;
    margin-top: 22px;
    padding: 10px 28px;
    border-radius: 6px;
    background: var(--music-text);
    color: var(--bg);
    font-weight: 750;
    font-size: 13.5px;
  }
  .read-more:hover { filter: brightness(1.1); }
  .release-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 18px;
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-size: 12.5px;
  }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tag {
    padding: 2px 9px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    color: var(--text-3);
  }
  .platforms { color: var(--text-4); }

  .recent {
    position: sticky;
    top: 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 20px;
  }
  .recent h2 { font-size: 18px; margin: 0 0 12px; }
  .recent ol { list-style: none; margin: 0; padding: 0; }
  .recent li a { display: block; padding: 10px 0; border-top: 1px solid var(--line); }
  .recent li a:hover .r-title { color: var(--music-text); }
  .r-title { display: block; font-size: 14px; font-weight: 650; line-height: 1.35; }
  .r-date { display: block; font-size: 12px; color: var(--text-4); }
  .recent-note { font-size: 12.5px; color: var(--text-4); margin: 14px 0 0; }
  .recent-note a { color: var(--music-text); }

  @media (max-width: 960px) {
    .timeline-layout { grid-template-columns: 1fr; }
    .recent { position: static; order: -1; }
  }
</style>
